# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Leave empty to use embedded MongoMemoryServer in local dev/test)
MONGODB_URI=

# Authentication Configuration
JWT_SECRET=iaue_student_hub_secure_jwt_secret_token_key_2026
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@iauestudenthub.ng
ADMIN_PASSWORD=AdminSecurePassword123!

# Web Scraping & Data Synchronization Subsystem
SCRAPER_ENABLED=true
SCRAPER_NEWS_INTERVAL_MINUTES=30
SCRAPER_PORTAL_INTERVAL_MINUTES=30
SCRAPER_ACADEMIC_INTERVAL_MINUTES=720
SCRAPER_OER_INTERVAL_MINUTES=360
SCRAPER_DOCUMENT_INTERVAL_MINUTES=360
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_REQUEST_TIMEOUT_MS=15000
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MS=1500
SCRAPER_MAX_PAGES_PER_RUN=200
SCRAPER_MAX_CRAWL_DEPTH=3
SCRAPER_USER_AGENT=IAUE-Student-Hub/1.0 (+https://iauestudenthub.ng)
